#!/bin/bash
# Switches GNOME, kitty, ddterm, the oh-my-posh prompt, Claude Code, nvim and
# emacs between day (light) and night (dark) themes.
# Usage: theme-switch [day|night|auto]
set -euo pipefail

MODE="${1:-auto}"

if [ "$MODE" = "auto" ]; then
    HOUR=$(date +%H)
    if [ "$HOUR" -ge 8 ] && [ "$HOUR" -lt 20 ]; then
        MODE=day
    else
        MODE=night
    fi
fi

# Records the active mode so other tools that render their own colours -- the
# Claude Code status line, for one -- can pick a palette without querying GNOME
# on every redraw.
_write_mode() {
    local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
    mkdir -p "$state_dir" 2>/dev/null || return 0
    printf '%s\n' "$1" > "$state_dir/theme-mode"
}

_switch_nvim() {
    local bg="$1"
    local runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    for sock in "$runtime_dir"/nvim*.* /tmp/nvim*; do
        [ -S "$sock" ] || continue
        nvim --server "$sock" --remote-send "<Esc>:set background=${bg}<CR>" 2>/dev/null || true
    done
}

_switch_kitty() {
    local variant="$1"
    local dir="$HOME/.config/kitty"
    [ -f "$dir/$variant" ] || return 0
    cp -f "$dir/$variant" "$dir/current-theme.conf"
    pkill -USR1 kitty 2>/dev/null || true
}

# oh-my-posh re-reads its config on every prompt, so replacing the active file
# repaints running shells at their next prompt.
_switch_posh() {
    local variant="$1"
    local dir="$HOME/.config/oh-my-posh"
    [ -f "$dir/config-$variant.json" ] || return 0
    cp -f "$dir/config-$variant.json" "$dir/config.json"
}

# ddterm keeps its colours in dconf and applies them to open terminals live.
_switch_ddterm() {
    local fg="$1" bg="$2" palette="$3"
    command -v dconf >/dev/null 2>&1 || return 0
    dconf write /com/github/amezin/ddterm/foreground-color "'$fg'" 2>/dev/null || true
    dconf write /com/github/amezin/ddterm/background-color "'$bg'" 2>/dev/null || true
    dconf write /com/github/amezin/ddterm/palette "$palette" 2>/dev/null || true
}

DDTERM_PALETTE_NIGHT="['rgb(65,72,104)', 'rgb(247,118,142)', 'rgb(115,218,202)', 'rgb(224,175,104)', 'rgb(122,162,247)', 'rgb(187,154,247)', 'rgb(125,207,255)', 'rgb(192,202,245)', 'rgb(65,72,104)', 'rgb(247,118,142)', 'rgb(115,218,202)', 'rgb(224,175,104)', 'rgb(122,162,247)', 'rgb(187,154,247)', 'rgb(125,207,255)', 'rgb(192,202,245)']"
DDTERM_PALETTE_DAY="['rgb(233,233,236)', 'rgb(245,42,101)', 'rgb(88,117,57)', 'rgb(140,108,62)', 'rgb(46,125,233)', 'rgb(152,84,241)', 'rgb(0,113,151)', 'rgb(97,114,176)', 'rgb(168,174,203)', 'rgb(245,42,101)', 'rgb(88,117,57)', 'rgb(140,108,62)', 'rgb(46,125,233)', 'rgb(152,84,241)', 'rgb(0,113,151)', 'rgb(208,213,227)']"

# The panel and menu surfaces come from a user shell theme, which needs the User
# Themes extension. Enabling it is idempotent, and a session that already has it
# on is untouched.
_switch_shell_theme() {
    local name="$1"
    local ext=user-theme@gnome-shell-extensions.gcampax.github.com
    [ -d "/usr/share/themes/$name/gnome-shell" ] || [ -d "$HOME/.themes/$name/gnome-shell" ] || return 0
    if command -v gnome-extensions >/dev/null 2>&1; then
        gnome-extensions enable "$ext" 2>/dev/null || true
    fi
    gsettings set org.gnome.shell.extensions.user-theme name "$name" 2>/dev/null || true
}

# Claude Code draws its own UI and defaults to the dark theme, unreadable on a
# light terminal. Rather than flipping the `theme` setting between light and
# dark -- which a running session does not pick up, and which churns a
# settings.json that may be under version control -- point the setting once at a
# custom theme and rewrite that theme's file per mode. A theme's slug is its
# filename, so themes/labstick.json is referenced as custom:labstick. A session
# already running keeps the theme it started with either way; the gain over
# flipping the setting is that settings.json stays constant.
#
# The one override is the background of a submitted message, set to GNOME's
# accent so it matches the desktop in both modes. There is no theme key for that
# element's text colour: it follows the base theme, which gives white-ish text
# on the accent in dark mode and dark text in light mode.
_switch_claude() {
    local base="$1"
    command -v python3 >/dev/null 2>&1 || return 0
    local accent
    accent=$(gsettings get org.gnome.desktop.interface accent-color 2>/dev/null | tr -d "'")
    python3 - "$HOME/.claude" "$base" "$accent" <<'PYEOF' 2>/dev/null || true
import json, os, pathlib, sys, tempfile

config_dir, base, accent = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3]

# libadwaita accent_bg_color: the value GNOME itself paints white text on.
ACCENTS = {
    "blue": "#3584e4", "teal": "#2190a4", "green": "#3a944a",
    "yellow": "#c88800", "orange": "#ed5b00", "red": "#e62d42",
    "pink": "#d56199", "purple": "#9141ac", "slate": "#6f8396",
}
bg = ACCENTS.get(accent, ACCENTS["blue"])


def lighten(colour, amount=0.15):
    r, g, b = (int(colour[i:i + 2], 16) for i in (1, 3, 5))
    return "#%02x%02x%02x" % tuple(round(c + (255 - c) * amount) for c in (r, g, b))


themes = config_dir / "themes"
themes.mkdir(parents=True, exist_ok=True)
(themes / "labstick.json").write_text(json.dumps({
    "name": "Labstick",
    "base": base,
    "overrides": {
        "userMessageBackground": bg,
        "userMessageBackgroundHover": lighten(bg),
    },
}, indent=2) + "\n")

# Point the setting at the theme once; after that the file carries the mode.
settings_path = config_dir / "settings.json"
try:
    settings = json.loads(settings_path.read_text())
except (OSError, ValueError):
    sys.exit(0)
if settings.get("theme") == "custom:labstick":
    sys.exit(0)
settings["theme"] = "custom:labstick"
tmp = tempfile.NamedTemporaryFile("w", dir=settings_path.parent, delete=False)
json.dump(settings, tmp, indent=2)
tmp.write("\n")
tmp.close()
os.replace(tmp.name, settings_path)
PYEOF
}

case "$MODE" in
    day)
        gsettings set org.gnome.desktop.interface color-scheme 'prefer-light'
        gsettings set org.gnome.desktop.interface accent-color 'slate'

        _write_mode day
        _switch_shell_theme LabDay
        _switch_kitty tokyonight-day.conf
        _switch_posh day
        _switch_ddterm 'rgb(55,96,191)' 'rgb(225,226,231)' "$DDTERM_PALETTE_DAY"
        _switch_claude light
        _switch_nvim light

        emacsclient --eval "(change-theme-to-light)" 2>/dev/null || true
        ;;

    night)
        gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
        gsettings set org.gnome.desktop.interface accent-color 'slate'

        _write_mode night
        _switch_shell_theme LabNight
        _switch_kitty tokyonight.conf
        _switch_posh night
        _switch_ddterm 'rgb(169,177,214)' 'rgb(26,27,38)' "$DDTERM_PALETTE_NIGHT"
        _switch_claude dark
        _switch_nvim dark

        emacsclient --eval "(change-theme-to-dark)" 2>/dev/null || true
        ;;

    *)
        echo "Usage: theme-switch [day|night|auto]" >&2
        exit 1
        ;;
esac
